{
  "name": "aeterna-document-editor",
  "displayName": "AETERNA Document Editor",
  "description": "AETERNA Document Manager with governed candidate editing, planning and explicit Apply.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:aeternaDocuments",
    "onCommand:aeterna.openManager",
    "onCommand:aeterna.editCandidate",
    "onCommand:aeterna.compareCandidate",
    "onCommand:aeterna.prepareUpdatePlan",
    "onCommand:aeterna.prepareMinorUpdatePlan",
    "onCommand:aeterna.prepareGovernanceUpdatePlan",
    "onCommand:aeterna.applyPreparedUpdate",
    "onCommand:aeterna.applyGovernanceUpdate",
    "onCommand:aeterna.newDocument",
    "onCommand:aeterna.prepareCreatePlan",
    "onCommand:aeterna.applyPreparedCreate"
  ],
  "main": "./out/src/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "proof-smoke": "npm run compile && node out/scripts/proof-smoke.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "aeterna.openManager",
        "title": "AETERNA: Open Document Manager"
      },
      {
        "command": "aeterna.refreshDocuments",
        "title": "AETERNA: Refresh Documents"
      },
      {
        "command": "aeterna.openDocument",
        "title": "AETERNA: Open Document"
      },
      {
        "command": "aeterna.resolveDocument",
        "title": "AETERNA: Resolve Document"
      },
      {
        "command": "aeterna.editCandidate",
        "title": "AETERNA: Edit Candidate (Does Not Apply)"
      },
      {
        "command": "aeterna.compareCandidate",
        "title": "AETERNA: Compare Candidate with Canonical"
      },
      {
        "command": "aeterna.prepareUpdatePlan",
        "title": "AETERNA: Prepare Unchanged-Version UPDATE Plan (Read Only)"
      },
      {
        "command": "aeterna.prepareMinorUpdatePlan",
        "title": "AETERNA: Prepare Versioned UPDATE Plan (Minor, Read Only)"
      },
      {
        "command": "aeterna.applyPreparedUpdate",
        "title": "AETERNA: Apply Prepared UPDATE (Explicit Approval)"
      },
      {
        "command": "aeterna.prepareGovernanceUpdatePlan",
        "title": "AETERNA: Prepare Governance UPDATE Plan (Major, Read Only)"
      },
      {
        "command": "aeterna.applyGovernanceUpdate",
        "title": "AETERNA: Approve Governance Apply (High Risk)"
      },
      {
        "command": "aeterna.showDiagnostics",
        "title": "AETERNA: Show Diagnostics"
      },
      {
        "command": "aeterna.newDocument",
        "title": "AETERNA: New Document Candidate (No Apply)"
      },
      {
        "command": "aeterna.prepareCreatePlan",
        "title": "AETERNA: Prepare CREATE Plan (Read Only)"
      },
      {
        "command": "aeterna.applyPreparedCreate",
        "title": "AETERNA: Apply Prepared CREATE (Explicit Approval)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aeterna.openManager",
          "when": "view == aeternaDocuments",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "aeterna.editCandidate",
          "when": "view == aeternaDocuments && viewItem == aeternaManagedDocument",
          "group": "inline@1"
        },
        {
          "command": "aeterna.compareCandidate",
          "when": "view == aeternaDocuments && viewItem == aeternaManagedDocument",
          "group": "navigation@2"
        },
        {
          "command": "aeterna.prepareUpdatePlan",
          "when": "view == aeternaDocuments && viewItem == aeternaManagedDocument",
          "group": "navigation@3"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "aeternaDocuments",
          "name": "AETERNA Documents"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.140.0",
    "typescript": "7.0.2"
  }
}
